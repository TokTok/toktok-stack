# kTox (jvm-toxcore-c/apps/client): Compose Multiplatform for the desktop. Gradle
# metadata picks each library's JVM variant, so this set uses the Gradle resolver.
# Pin after changing it: bazel run @ktox_maven//:pin
maven.install(
    name = "ktox_maven",
    artifacts = [
        "androidx.sqlite:sqlite-bundled:2.7.1",
        "com.google.zxing:core:3.5.4",
        "org.jetbrains.compose.desktop:desktop-jvm-linux-x64:1.12.2",
        "org.jetbrains.compose.foundation:foundation:1.12.2",
        "org.jetbrains.compose.material3:material3:1.9.0",
        "org.jetbrains.compose.material:material-icons-core:1.7.3",
        "org.jetbrains.compose.runtime:runtime:1.12.2",
        "org.jetbrains.compose.ui:ui:1.12.2",
        "org.jetbrains.kotlin:kotlin-compose-compiler-plugin-embeddable:2.4.21",
        "org.jetbrains.kotlin:kotlin-test-junit:2.4.21",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core:1.11.0",
        "org.jetbrains.kotlinx:kotlinx-coroutines-swing:1.11.0",
    ],
    lock_file = "//jvm-toxcore-c/apps/client:ktox_maven_install.json",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    resolver = "gradle",
)

# Gradle redirects these multiplatform roots to the artifact on the right, but
# the Gradle resolver pins the roots themselves (Android .aar files, or jars
# with another file's checksum). The desktop build uses what they redirect to.
[
    maven.override(
        name = "ktox_maven",
        coordinates = root,
        target = "@ktox_maven//:" + jvm.replace(".", "_").replace(":", "_").replace("-", "_"),
    )
    for root, jvm in [
        ("androidx.annotation:annotation", "androidx.annotation:annotation-jvm"),
        ("androidx.collection:collection", "androidx.collection:collection-jvm"),
        ("androidx.compose.runtime:runtime", "androidx.compose.runtime:runtime-desktop"),
        ("androidx.compose.runtime:runtime-annotation", "androidx.compose.runtime:runtime-annotation-jvm"),
        ("androidx.compose.runtime:runtime-retain", "androidx.compose.runtime:runtime-retain-desktop"),
        ("androidx.compose.runtime:runtime-saveable", "androidx.compose.runtime:runtime-saveable-desktop"),
        ("androidx.lifecycle:lifecycle-common", "androidx.lifecycle:lifecycle-common-jvm"),
        ("androidx.lifecycle:lifecycle-runtime", "androidx.lifecycle:lifecycle-runtime-desktop"),
        ("androidx.lifecycle:lifecycle-runtime-compose", "androidx.lifecycle:lifecycle-runtime-compose-desktop"),
        ("androidx.lifecycle:lifecycle-viewmodel", "androidx.lifecycle:lifecycle-viewmodel-desktop"),
        ("androidx.lifecycle:lifecycle-viewmodel-compose", "androidx.lifecycle:lifecycle-viewmodel-compose-desktop"),
        ("androidx.lifecycle:lifecycle-viewmodel-savedstate", "androidx.lifecycle:lifecycle-viewmodel-savedstate-desktop"),
