# Dev container base image.
#
# Individual devs can create their own images based on this one. This image
# contains a few basic tools and has built and ran all the tests once, so the
# results are cached. This is the quickest way to get started with TokTok
# development.
FROM toxchat/toktok-stack:latest

# Install our wrapper for lhs support in stylish-haskell.
#RUN mv /usr/bin/stylish-haskell /usr/bin/stylish-haskell.distrib \
# && ln -s /src/workspace/ci-tools/bin/stylish-haskell-lhs /usr/bin/stylish-haskell

ENV USER=builder \
    NIX_PATH="/home/builder/.nix-defexpr/channels:nixpkgs=/home/builder/.nix-defexpr/nixpkgs"

# Add default configs and dotfiles before installing home-manager.
# Activate with toktok.devTools.enable = false here so latest-dev stays lean
# (e.g. for GitHub Actions); Dockerfile.devtools layers the full toolset on top.
COPY --chown=builder:users tools/built/src/home /home/builder/
COPY --chown=builder:users tools/built/src/home/.config/home-manager/home.nix /src/workspace/tools/built/src/home/.config/home-manager/home.nix

# Reuse Bazel's already-unpacked nixpkgs tree (~495 MB) instead of downloading
# a duplicate copy via nix-channel.
RUN printf '{ ... }: {\n  imports = [ /src/workspace/tools/built/src/home/.config/home-manager/home.nix ];\n  toktok.devTools.enable = false;\n}\n' \
      > /home/builder/.config/home-manager/home.nix \
 && mkdir -p /home/builder/.nix-defexpr \
 && ln -s /home/builder/.cache/bazel/_bazel_builder/*/external/rules_nixpkgs_core++nix_repo+nixpkgs /home/builder/.nix-defexpr/nixpkgs \
 && test -d /home/builder/.nix-defexpr/nixpkgs/pkgs \
 && sudo rm -f /nix/var/nix/daemon-socket/socket \
 && (sudo nix-daemon --daemon >/dev/null 2>&1 &) \
 && for _ in $(seq 1 50); do [ -S /nix/var/nix/daemon-socket/socket ] && break; sleep 0.2; done \
 && export NIX_REMOTE=daemon \
 && nix-channel --add "https://github.com/nix-community/home-manager/archive/b56bcd042b5e69ad188eca20d9bec1bfbf3dd453.tar.gz" home-manager \
 && nix-channel --update \
 && nix-shell '<home-manager>' -A install \
 && nix-collect-garbage -d \
 && (sudo pkill -x nix-daemon || true) \
 && sudo rm -f /nix/var/nix/daemon-socket/socket

# Prepare builder's home with toxcore's astylerc and TokTok's home.nix.
RUN ["ln", "-sf", "/src/workspace/c-toxcore/other/astyle/astylerc", "/home/builder/.astylerc"]
RUN ["ln", "-sf", "/src/workspace/tools/built/src/home/.config/home-manager/home.nix", "/home/builder/.config/home-manager/home.nix"]

# For local development: the setup script might have changed and is an
# extension of the Dockerfile, so we copy it here. On CI builds, they are
# the same file.
COPY tools/built/src/setup-dev.sh /src/workspace/tools/built/src/
RUN ["/src/workspace/tools/built/src/setup-dev.sh"]

EXPOSE 22/tcp

# vim:ft=dockerfile
